#!/data/data/com.termux/files/usr/bin/bash
# 用 Claude 订阅账号（Pro / Max）登录 Claude Code。由 App 设置页在终端中打开。
# 用法：ccm-login [--logout | --status]
export CCM_SKIP_AUTH_CHECK=1
. "$HOME/.ccmobile/bin/ccm-env"
unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY ANTHROPIC_MODEL
# 让 Claude Code 能用系统浏览器打开授权链接
command -v termux-open-url >/dev/null && export BROWSER=termux-open-url

case "$1" in
    --logout) exec "${CCM_RUN[@]}" auth logout ;;
    --status) exec "${CCM_RUN[@]}" auth status ;;
esac

if [ "$CCM_LANG" = "en" ]; then
    echo "Sign in to Claude with your Pro / Max subscription"
    echo "1. A link will open in your browser (or tap the link below)"
    echo "2. Authorize, then come back here (paste the code if asked)"
else
    echo "使用 Claude 订阅账号（Pro / Max）登录"
    echo "1. 接下来会在浏览器打开授权链接（没打开就长按下面的链接）"
    echo "2. 授权完成后回到这里；如果页面给出验证码，粘贴到这里回车"
fi
echo
"${CCM_RUN[@]}" auth login --claudeai
echo
"${CCM_RUN[@]}" auth status
echo
if [ "$CCM_LANG" = "en" ]; then
    echo "Done. Return to CCMobile — press Enter to close this window."
else
    echo "完成。按回车关闭此窗口，回到 CCMobile 即可使用。"
fi
read -r _
