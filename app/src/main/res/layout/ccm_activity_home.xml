<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ccm_bg"
    android:fitsSystemWindows="true">

    <!-- ============ 主区域 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageButton
                android:id="@+id/btn_menu"
                style="@style/Ccm.IconButton"
                android:contentDescription="@string/ccm_menu"
                android:src="@drawable/ccm_ic_menu"
                app:tint="@color/ccm_text" />

            <LinearLayout
                android:id="@+id/project_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/project_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxWidth="220dp"
                        android:singleLine="true"
                        android:textColor="@color/ccm_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ccm_ic_chevron_down"
                        app:tint="@color/ccm_text_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/project_path"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="@color/ccm_text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_undo"
                style="@style/Ccm.IconButton"
                android:contentDescription="@string/ccm_undo_last_turn"
                android:src="@drawable/ccm_ic_undo"
                app:tint="@color/ccm_text" />

            <ImageButton
                android:id="@+id/btn_new_chat"
                style="@style/Ccm.IconButton"
                android:contentDescription="@string/ccm_new_chat"
                android:src="@drawable/ccm_ic_edit_note"
                app:tint="@color/ccm_text" />
        </LinearLayout>

        <!-- 未就绪提示条：环境或 API 未配置时常驻显示 -->
        <TextView
            android:id="@+id/setup_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/ccm_bg_card_alt"
            android:backgroundTint="@color/ccm_accent_soft"
            android:drawableEnd="@drawable/ccm_ic_chevron_right"
            android:drawableTint="@color/ccm_accent"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/ccm_text"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 消息区 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/chat_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/messages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp" />
            </androidx.core.widget.NestedScrollView>

            <!-- 空状态 -->
            <ScrollView
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="24dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ccm_ic_logo"
                        app:tint="@color/ccm_accent" />

                    <TextView
                        android:id="@+id/empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="serif"
                        android:text="@string/ccm_empty_title"
                        android:textColor="@color/ccm_text"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/empty_subtitle"
                        style="@style/Ccm.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/suggestions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- 输入区 -->
        <LinearLayout
            android:id="@+id/composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/ccm_bg_composer"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <HorizontalScrollView
                android:id="@+id/attachments_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/attachments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingTop="4dp" />
            </HorizontalScrollView>

            <EditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="@string/ccm_input_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="6"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textColor="@color/ccm_text"
                android:textColorHint="@color/ccm_text_tertiary"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_attach"
                    style="@style/Ccm.IconButton"
                    android:contentDescription="@string/ccm_add_image"
                    android:src="@drawable/ccm_ic_add" />

                <!-- 模式和模型标签放在可收缩的容器里：文字过长时截断，不会把发送按钮挤出屏幕 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/ccm_bg_chip"
                    android:drawablePadding="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxWidth="140dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="@color/ccm_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip_model"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/ccm_bg_chip"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxWidth="150dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/ccm_text_secondary"
                    android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/phone_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:drawablePadding="5dp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/btn_send"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/ccm_bg_send"
                    android:contentDescription="@string/ccm_send"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ccm_ic_send"
                    app:tint="@color/ccm_on_accent" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ============ 侧边栏 ============ -->
    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/ccm_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ccm_ic_logo"
                app:tint="@color/ccm_accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="CCMobile"
                android:textColor="@color/ccm_text"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/drawer_new_chat"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackground"
            android:drawableStart="@drawable/ccm_ic_edit_note"
            android:drawablePadding="12dp"
            android:drawableTint="@color/ccm_accent"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="@string/ccm_new_chat"
            android:textColor="@color/ccm_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/drawer_projects"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackground"
            android:drawableStart="@drawable/ccm_ic_folder"
            android:drawablePadding="12dp"
            android:drawableTint="@color/ccm_text_secondary"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:text="@string/ccm_projects"
            android:textColor="@color/ccm_text"
            android:textSize="15sp" />

        <TextView
            style="@style/Ccm.Text.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="6dp"
            android:text="@string/ccm_recent_chats" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/drawer_sessions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ccm_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/drawer_settings"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ccm_ic_settings"
                android:drawablePadding="8dp"
                android:drawableTint="@color/ccm_text_secondary"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="@string/ccm_settings"
                android:textColor="@color/ccm_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/drawer_phone"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ccm_ic_phone"
                android:drawablePadding="8dp"
                android:drawableTint="@color/ccm_text_secondary"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="@string/ccm_connect"
                android:textColor="@color/ccm_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/drawer_terminal"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:drawableStart="@drawable/ccm_ic_terminal"
                android:drawablePadding="8dp"
                android:drawableTint="@color/ccm_text_secondary"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:text="@string/ccm_terminal"
                android:textColor="@color/ccm_text"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
